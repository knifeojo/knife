// SQLite locally. For Postgres: change provider to "postgresql" and set DATABASE_URL.
// Enums are stored as strings so the schema stays portable across providers.
// Money is stored in integer minor units (kobo for NGN).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  googleSub    String?  @unique
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  aiConsent    Boolean  @default(false)
  // Per-feature AI route chosen in Settings: local | cloud | off. Null follows the server (AI_PROVIDER, AI_*).
  aiCategorize String?
  aiEscalation String?
  aiInsights   String?
  aiChat       String?
  // Onboarding ("Who are your people?"): set when the owner saved or skipped it. Null shows it once.
  onboardedAt     DateTime?
  // single | married | engaged | relationship | private
  relationshipStatus String?
  // Set when the owner finished or closed "You send money to these people most" after the first upload.
  topPeopleDoneAt DateTime?
  // official = public daily market rates; street = the user's manual NGN override (street and official naira rates differ).
  // Realised rates from the owner's own wallet-to-bank conversions always win for that pair.
  fxNgnPreference String @default("official") // official | street

  sessions     Session[]
  evalRuns     EvalRun[]
  connections  FinancialConnection[]
  accounts     Account[]
  transactions Transaction[]
  syncRuns     SyncRun[]
  loans        Loan[]
  suggestions  CategorySuggestion[]
  people       Person[]
  peopleBatches PeopleBatch[]
  // Personal inbound address token (alerts-<token>@domain) and iOS Shortcuts SMS token.
  inboundEmailToken String? @unique
  smsIngestToken    String? @unique

  unparsedAlerts    UnparsedAlert[]
  balanceGaps       BalanceGap[]
  reconFlags        ReconFlag[]
  forwardingNotices ForwardingNotice[]
  processedAlerts   ProcessedAlert[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// One row per data source a user has connected (gmail, fixture, demo, later mono/statement/sms).
model FinancialConnection {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider               String // gmail | fixture | demo | imap | statement
  providerAccountId      String? // e.g. the Gmail address or IMAP username
  status                 String    @default("active") // active | revoked | error
  encryptedRefreshToken  String?
  encryptedAccessToken   String?
  accessTokenExpiresAt   DateTime?
  scope                  String?
  gmailHistoryId         String?
  lastSyncedAt           DateTime?
  lastProcessedMessageId String?
  lastError              String?
  // IMAP host/port/user only. The app password lives in a local env/secret file, never in this row.
  imapHost               String?
  imapPort               Int?
  imapUser               String?
  syncIntervalMinutes    Int? // null = server default (ALERT_SYNC_MINUTES, 5)
  nextRetryAt            DateTime?
  backoffMs              Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  syncRuns        SyncRun[]
  processedEmails ProcessedEmail[]

  @@unique([userId, provider])
}

model Account {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution         String
  accountName         String
  maskedAccountNumber String // only last 4 digits are ever stored, e.g. "****1234"
  holderName          String? // account holder, used to spot transfers between the user's own accounts
  currency            String    @default("NGN")
  balanceMinor        BigInt?
  balanceUpdatedAt    DateTime?
  // Inclusive Lagos range covered by the latest imported statement (for alert-vs-statement recon).
  statementCoveredFrom DateTime?
  statementCoveredTo   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  transactions Transaction[]

  @@unique([userId, institution, maskedAccountNumber])
}

model Transaction {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId                String
  account                  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  source                   String // first source that created the row: gmail | imap | inbound | statement | mono | sms | fixture | demo | manual
  sourceTransactionId      String
  fingerprint              String
  transactionDate          DateTime
  type                     String // CREDIT | DEBIT (extensible: REVERSAL, REFUND, FEE, ...)
  amountMinor              BigInt
  currency                 String
  balanceAfterMinor        BigInt?
  description              String
  reference                String?
  counterparty             String?
  merchantName             String?
  category                 String
  subcategory              String?
  classificationSource     String // rule | user | ai | default
  classificationConfidence Float
  parseConfidence          Float    @default(1)
  // The other leg when money moved between two of the user's own accounts (both legs point at each other).
  transferPairId           String?
  // Quoted proceeds in another currency (a Deel USD withdrawal that states the NGN received).
  // Feeds FX learning before the matching bank credit is imported.
  fxQuoteCurrency          String?
  fxQuoteMinor             BigInt?
  // Inferred from the narration (Ghana MoMo, a Nigerian bank payout). Low confidence; never a received amount.
  destinationCountry       String?
  destinationCurrency      String?
  // The known person on the other side, when the name matched one confidently (see core/people).
  personId                 String?
  person                   Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  // A fee/VAT/stamp-duty alert linked to the adjacent transfer (same minute, same account).
  feeOfId                  String?
  feeOf                    Transaction?  @relation("FeeOf", fields: [feeOfId], references: [id], onDelete: SetNull)
  fees                     Transaction[] @relation("FeeOf")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  sources    TransactionSource[]
  suggestion CategorySuggestion?

  @@unique([userId, fingerprint])
  @@index([userId, transactionDate])
  @@index([userId, category])
  @@index([userId, personId])
}

// Someone the owner pays or is paid by, and who they are to the owner. The relationship decides the
// category of every payment to or from them (core/people-match mappingFor), ahead of the AI.
model Person {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String
  // spouse | sibling | parent | child | extended | friend | vendor | colleague | me | other
  relationship      String
  note              String?
  // Vendors only: what the owner buys from them.
  vendorCategory    String?
  vendorSubcategory String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  aliases      PersonAlias[]
  transactions Transaction[]

  @@index([userId])
}

// A name as banks write it ("OJO GIFT A", "TRF TO GIFT"). `rejected` records the owner saying that
// spelling is NOT this person, so fuzzy matching stops proposing it.
model PersonAlias {
  id        String   @id @default(cuid())
  userId    String
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  name      String
  // Normalized name words, sorted: one row per spelling per person.
  key       String
  rejected  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([personId, key])
  @@index([userId])
}

// One relabel from a People answer or edit, kept so it can be undone. JSON is stored as text.
model PeopleBatch {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Not a relation: the person may be deleted by an undo or a merge.
  personId  String?
  label     String
  // [{ id, category, subcategory, classificationSource, classificationConfidence, personId }] as they were before.
  changes   String
  // The person (with aliases) before the change, or null when the change created them.
  before    String?
  // Name rules from earlier Review answers that this person replaced.
  removedRules String  @default("[]")
  createdAt DateTime  @default(now())
  undoneAt  DateTime?

  @@index([userId, createdAt])
}

// Every observation of a transaction from any source. Enables dedup audit and future reconciliation.
model TransactionSource {
  id                  String      @id @default(cuid())
  userId              String
  transactionId       String
  transaction         Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  source              String
  sourceTransactionId String
  matchType           String // created | exact | fuzzy
  createdAt           DateTime    @default(now())

  @@unique([userId, source, sourceTransactionId])
}

// Merchant normalization. userId null = global rule; user rows are learned from corrections.
model MerchantAlias {
  id            String   @id @default(cuid())
  userId        String?
  pattern       String // lowercase substring matched against normalized description
  canonicalName String
  category      String?
  subcategory   String?
  createdAt     DateTime @default(now())

  @@unique([userId, pattern])
}

// Metadata only. Email bodies are never persisted.
model ProcessedEmail {
  id            String              @id @default(cuid())
  userId        String
  connectionId  String
  connection    FinancialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  messageId     String
  sender        String
  subject       String
  receivedAt    DateTime
  status        String // parsed | duplicate | skipped | failed
  parser        String?
  transactionId String?
  createdAt     DateTime            @default(now())

  @@unique([userId, messageId])
}

model SyncRun {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId   String
  connection     FinancialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  status         String // running | success | failed
  startedAt      DateTime            @default(now())
  finishedAt     DateTime?
  emailsScanned  Int                 @default(0)
  parsed         Int                 @default(0)
  created        Int                 @default(0)
  duplicates     Int                 @default(0)
  parseFailures  Int                 @default(0)
  skipped        Int                 @default(0)
  avgConfidence  Float?
  error          String?
  label          String? // what was imported, e.g. "statement.pdf · GTBank ••3533"
  linked         Int                 @default(0) // transfers between the user's own accounts linked by this import
  balanceBreaks  Int                 @default(0) // rows where running balance did not follow from the previous row
  gapMinor       BigInt? // money unaccounted for by the imported rows (statement balance vs imported amounts)
  seenAt         DateTime? // when the user dismissed the result banner
}

// Accuracy snapshots: how often automatic categorization matches what the user said.
model EvalRun {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method        String // rules | rules+ai
  labelled      Int
  correct       Int
  labelledMinor BigInt
  correctMinor  BigInt
  coverage      Float // share of spending (by value) in a specific category, not Transfers/Other
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

// What the AI proposed for a transaction the rules could not place. Never applied on its own: the
// transaction keeps its rule label until the owner confirms in Review (which then becomes a user rule).
// One row per transaction, so a backlog run can stop and resume without asking twice.
model CategorySuggestion {
  id                   String      @id @default(cuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId        String      @unique
  transaction          Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  classificationSource String      @default("ai")
  provider             String // ollama | anthropic: whoever produced the stored answer (after escalation)
  model                String
  // Null when the model gave no valid answer for this row (status "failed").
  category             String?
  subcategory          String?
  reason               String?
  confidence           Float?
  status               String      @default("pending") // pending | confirmed | dismissed | superseded | failed
  createdAt            DateTime    @default(now())
  decidedAt            DateTime?

  @@index([userId, status])
}

// Cached FX: 1 unit of `base` = `rate` units of `quote` (both in major units).
// source: realised (owner's own paired conversion) | market (public daily feed) | manual (Settings) | seed.
// userId is empty for shared market/seed rows; set for per-user realised and manual rates.
model FxRate {
  id        String   @id @default(cuid())
  date      String // YYYY-MM-DD, Lagos calendar day
  base      String
  quote     String
  rate      Float
  source    String
  userId    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, base, quote, source])
  @@index([base, quote, date])
  @@index([userId, base, quote])
}

// Rows a statement contained but Ledger could not read. Nothing is silently dropped: the user can add
// each one to the ledger (prefilled) or mark it as not a transaction.
model ImportIssue {
  id         String    @id @default(cuid())
  userId     String
  syncRunId  String
  fileLabel  String
  rowNumber  Int
  reason     String
  rawText    String // the row as printed on the statement
  accountId  String?
  status     String    @default("open") // open | added | ignored
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, status])
}

// A loan the user typed in from their lender's app. Bank statements show repayments but never the balance left.
// Instalments are monthly. Dates are Lagos calendar days stored at 00:00 UTC.
model Loan {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lender           String // a canonical name from lender detection (categorize.ts LENDERS), e.g. "Renmoney"
  outstandingMinor BigInt // balance left, as the lender's app shows it
  instalmentMinor  BigInt?
  instalmentsPaid  Int?
  instalmentsTotal Int?
  nextDueDate      DateTime?
  endDate          DateTime? // the last instalment's due date
  notes            String?
  status           String    @default("open") // open | closed
  // When the balance and instalments were last entered. Statement repayments after this are not in them yet.
  balanceAsOf      DateTime  @default(now())
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status])
}

// Bank alert that a parser recognised as a sender but could not turn into a transaction,
// or a low-confidence fallback match waiting in Review. Raw text stays on this machine.
model UnparsedAlert {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    String // email | sms
  sender     String
  receivedAt DateTime
  rawText    String
  reason     String // unparsed | low_confidence | known_sender
  parser     String?
  status     String    @default("open") // open | added | ignored
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, status])
}

// Running-balance gap: previous Bal +/- Amt != this Bal. Possible missed transaction.
model BalanceGap {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId     String
  previousTxId  String?
  currentTxId   String?
  expectedMinor BigInt
  actualMinor   BigInt
  gapMinor      BigInt
  atDate        DateTime
  status        String   @default("open") // open | dismissed
  createdAt     DateTime @default(now())

  @@unique([userId, currentTxId])
  @@index([userId, status])
}

// Alert vs statement mismatches after a statement covers a date range.
model ReconFlag {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId     String?
  transactionId String?
  kind          String // alert_without_statement | statement_without_alert | missed_transaction
  detail        String
  status        String   @default("open") // open | dismissed
  createdAt     DateTime @default(now())

  @@index([userId, status])
}

// Gmail "forwarding confirmation" code/link surfaced so the owner can finish setup.
model ForwardingNotice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String?
  link       String?
  subject    String
  receivedAt DateTime
  status     String   @default("new") // new | dismissed
  createdAt  DateTime @default(now())

  @@index([userId, status])
}

// Dedup watermark for SMS / inbound / IMAP messages (email Gmail still uses ProcessedEmail).
model ProcessedAlert {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       String // email | sms
  sourceId      String
  sender        String
  subject       String?
  receivedAt    DateTime
  status        String // parsed | duplicate | skipped | failed | review | unparsed | confirmation
  parser        String?
  transactionId String?
  createdAt     DateTime @default(now())

  @@unique([userId, channel, sourceId])
}
