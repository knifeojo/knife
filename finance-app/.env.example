DATABASE_URL="file:./dev.db"
# 32 random bytes, base64. Encrypts OAuth tokens at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
APP_URL="http://localhost:3000"
# Google OAuth (Gmail read-only). Leave blank to use demo + fixture mode only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional AI categorization. Local by default: Ollama on this machine (see README, "Local AI categorization").
# AI_PROVIDER=ollama | anthropic | off. The cloud (anthropic) only runs when set here explicitly.
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
# 8 GB RAM: qwen2.5:3b or llama3.2:3b. 16 GB+: qwen2.5:7b or llama3.1:8b.
OLLAMA_MODEL="qwen2.5:3b"
# Only used with AI_PROVIDER=anthropic (cloud categorizer and Insights assistant).
ANTHROPIC_API_KEY=""
