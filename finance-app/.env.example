DATABASE_URL="file:./dev.db"
# 32 random bytes, base64. Encrypts OAuth tokens at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
APP_URL="http://localhost:3000"
# Google OAuth (Gmail read-only). Leave blank to use demo + fixture mode only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# AI routing (see README, "AI: hybrid local + cloud routing"). Each user also turns AI on in Settings.
# AI_PROVIDER=hybrid (default) | ollama | anthropic | off
#   hybrid: categorization on local Ollama; second opinions, Insights phrasing and chat on Anthropic (redacted).
#   ollama: everything stays on this machine. anthropic: cloud for all. off: no AI.
AI_PROVIDER="hybrid"
# Optional per-feature overrides: local | cloud | off. Users can override again in Settings.
# AI_CATEGORIZE=""
# AI_ESCALATION=""
# AI_INSIGHTS=""
# AI_CHAT=""
OLLAMA_BASE_URL="http://localhost:11434"
# 8 GB RAM: qwen2.5:3b or llama3.2:3b. 16 GB+: qwen2.5:7b or llama3.1:8b.
OLLAMA_MODEL="qwen2.5:3b"
# Optional: a bigger local model for AI_ESCALATION=local.
# OLLAMA_ESCALATION_MODEL="qwen2.5:7b"
# Cloud model key (console.anthropic.com -> API keys). Leave blank and hybrid runs local-only.
# Only redacted data is sent: no names, account/card/phone numbers, emails or exact amounts.
ANTHROPIC_API_KEY=""
