ENCRYPTION_KEY=""
APP_URL="http://localhost:3000"
# Google OAuth (Gmail read-only). Leave blank to use demo + fixture mode only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional. When set, Insights answers are phrased by Claude from pre-computed facts.
ANTHROPIC_API_KEY=""
