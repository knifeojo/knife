DATABASE_URL="file:./dev.db"
# 32 random bytes, base64. Encrypts OAuth tokens at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
APP_URL="http://localhost:3000"
# Google OAuth (Gmail read-only). Leave blank to use demo + fixture mode only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# AI routing (see README, "AI: hybrid local + cloud routing"). Each user also turns AI on in Settings.
# AI_PROVIDER=hybrid (default) | ollama | anthropic | off
#   hybrid: categorization on local Ollama; second opinions, Insights phrasing and chat on Anthropic (redacted).
#   ollama: everything stays on this machine. anthropic: cloud for all. off: no AI.
AI_PROVIDER="hybrid"
# Optional per-feature overrides: local | cloud | off. Users can override again in Settings.
# AI_CATEGORIZE=""
# AI_ESCALATION=""
# AI_INSIGHTS=""
# AI_CHAT=""
OLLAMA_BASE_URL="http://localhost:11434"
# 8 GB RAM: qwen2.5:3b or llama3.2:3b. 16 GB+: qwen2.5:7b or llama3.1:8b.
OLLAMA_MODEL="qwen2.5:3b"
# Optional: a bigger local model for AI_ESCALATION=local.
# OLLAMA_ESCALATION_MODEL="qwen2.5:7b"
# Cloud model key (console.anthropic.com -> API keys). Leave blank and hybrid runs local-only.
# Only redacted data is sent: no names, account/card/phone numbers, emails or exact amounts.
ANTHROPIC_API_KEY=""

# Alert ingestion (see docs/alert-ingestion.md). Passwords/secrets never go in the repo.
# ALERT_SYNC_MINUTES=5
# ALERT_SYNC=0
# IMAP_PASSWORD=""
# LEDGER_SECRET_FILE=""
# INBOUND_EMAIL_SECRET=""
# INBOUND_EMAIL_DOMAIN=""
# SMS_SENDERS=""
# POSTMARK_INBOUND_SECRET=""
# Statement PDFs. Optional dedicated key; otherwise ENCRYPTION_KEY seals them.
# 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# STATEMENT_PASSWORD_KEY=""
# STATEMENT_PASSWORD_FILE=""
# GMAIL_QUERY_STATEMENTS=""
# JSON array overriding statement-email rules: [{ "id", "institution", "senders", "subject", "filename" }]
# STATEMENT_EMAIL_RULES=""
# Extra sender domains for the wallet provider (Pesa by default), comma-separated.
# WALLET_STATEMENT_SENDERS=""
# WALLET_STATEMENT_INSTITUTION=""
# Sideload APK updates. npm run app:release writes latest.apk and latest.json here.
# The phone calls GET /api/v1/app/latest and GET /api/v1/app/apk with its session token.
# APP_RELEASE_DIR=""
# Default when unset: ~/ledger-private/releases
